# Placeholder configuration for running Immergo fully offline.
PROJECT_ID=immergo-local
GOOGLE_CLOUD_PROJECT=immergo-local
LOCATION=us-central1
MODEL=gemini-live-2.5-flash-native-audio
DEV_MODE=true
# Placeholders so /api/status reports "production" (no Simple Mode banner).
# DEV_MODE=true makes the server skip reCAPTCHA validation and the Redis ping,
# and the browser gets tokens from the local reCAPTCHA JS stub.
RECAPTCHA_SITE_KEY=6LeSYx8sAAAAAGdRAp8VQ2K9I-KYGWBykzayvQ8n
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TIME_LIMIT=180
PER_USER_RATE_LIMIT="30 per minute"
