#!/bin/bash
# Pass-through grep; answers "grep ... /proc/stat" with a plausible CPU line.
last="${!#}"
if [[ "$last" == "/proc/stat" ]]; then
	s=$(( $(date +%s) % 100000 ))
	echo "cpu  $((2841000 + s*9)) 1203 $((913000 + s*3)) $((44120000 + s*388)) 8102 0 6213 0 0 0"
	exit 0
fi
exec /usr/bin/grep "$@"
