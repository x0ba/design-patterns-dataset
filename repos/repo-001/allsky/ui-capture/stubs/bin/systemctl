#!/bin/bash
# Stub for systemd on the Pi: every Allsky service reports as running.
case "$1" in
	is-active) echo "active" ;;
	is-failed) echo "active"; exit 1 ;;
	is-enabled) echo "enabled" ;;
	show) echo "4127" ;;
	start|stop|restart|reload|enable|disable|daemon-reload) exit 0 ;;
	status) echo "● ${2}.service - Allsky"; echo "     Active: active (running)" ;;
esac
exit 0
