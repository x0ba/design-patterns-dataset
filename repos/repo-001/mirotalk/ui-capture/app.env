# Environment for the local UI capture run (exported by start.sh; dotenv never overrides these)
NODE_ENV=production
TZ=UTC
LOGS_DEBUG=false
LOGS_COLORS=false
JWT_KEY=3f9c1a7e5b2d48f0a6c4e8b1d7f2a9c5e3b6d0f4a8c2e7b1d5f9a3c6e0b4d8f2
CORS_ORIGIN='*'
HOST_PROTECTED=false
HOST_USER_AUTH=false
HOST_USERS=""
OIDC_ENABLED=false
# No external STUN/TURN: local only (WebRTC host candidates work on localhost)
STUN_SERVER_ENABLED=false
TURN_SERVER_ENABLED=false
SHOW_ACTIVE_ROOMS=true
SURVEY_ENABLED=false
REDIRECT_ENABLED=false
API_KEY_SECRET=mirotalkp2p_local_capture_secret
API_DISABLED='[]'
# ChatGPT + chat translation -> local OpenAI-compatible stub
CHATGPT_ENABLED=true
CHATGPT_BASE_PATH=http://127.0.0.1:4450/v1/
CHATGPT_APIKEY=sk-local-placeholder
CHATGPT_MODEL=gpt-6-luna
CHATGPT_MAX_TOKENS=1000
CHATGPT_TEMPERATURE=0
CHATGPT_REASONING_EFFORT=none
CHAT_TRANSLATION_ENABLED=true
WHISPER_ENABLED=false
KLIPY_API_ENABLED=false
IP_LOOKUP_ENABLED=false
SENTRY_ENABLED=false
EMAIL_ALERT=false
STATS_ENABLED=false
WEBHOOK_ENABLED=false
NGROK_ENABLED=false
SLACK_ENABLED=false
MATTERMOST_ENABLED=false
UI_LANGUAGE=en
UI_TRANSLATION_MODE=native
