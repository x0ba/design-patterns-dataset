										<span>for comfortable viewing</span>
									</p>
								</figure>
							</li>
							<li role="listitem">
								<figure>
									<p>
										<span data-anim-keyframe="{&quot;start&quot;:&quot;a0t - 75vh&quot;,&quot;end&quot;:&quot;a0t + 50vh&quot;,&quot;cssClass&quot;:&quot;slide&quot;,&quot;anchors&quot;: [&quot;.subsection-touts&quot;],&quot;toggle&quot;:false}">ProMotion</span>
										<span>adaptive 10–120Hz refresh rate</span>
