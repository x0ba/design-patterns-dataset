35294118%2C0%2C98.088235294118%2C100&amp;w=1200 1200w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/05/STKB355_SPACEX_C.jpg?quality=90&amp;strip=all&amp;crop=0.95588235294118%2C0%2C98.088235294118%2C100&amp;w=1440 1440w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/05/STKB355_SPACEX_C.jpg?quality=90&amp;strip=all&amp;crop=0.95588235294118%2C0%2C98.088235294118%2C100&amp;w=1920 1920w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/05/STKB355_SPACEX_C.jpg?quality=90&amp;strip=all&amp;crop=0.95588235294118%2C0%2C98.088235294118%2C100&amp;w=2048 2048w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/05/STKB355_SPACEX_C.jpg?quality=90&amp;strip=all&amp;crop=0.95588235294118%2C0%2C98.088235294118%2C100&amp;w=2400 2400w" src="https://platform.theverge.com/wp-content/uploads/sites/2/2025/05/STKB355_SPACEX_C.jpg?quality=90&amp;strip=all&amp;crop=0.95588235294118%2C0%2C98.088235294118%2C100&amp;w=2400"></p><div><p>Elon Musk wants to take on AT&amp;T, T-Mobile, and Verizon.</p></div></div><div role="article" id="latest-dmcyOnF1aWNrUG9zdDoxMDI5MjQ4"><div><p><img alt="Richard Lawler" data-chromatic="ignore" loading="lazy" width="34" height="34" decoding="async" data-nimg="1" srcset="https://platform.theverge.com/wp-content/uploads/sites/2/2025/01/RICHARD_BLURPLE.jpg?quality=90&amp;strip=all&amp;crop=0%2C0%2C100%2C100&amp;w=48 1x, https://platform.theverge.com/wp-content/uploads/sites/2/2025/01/RICHARD_BLURPLE.jpg?quality=90&amp;strip=all&amp;crop=0%2C0%2C100%2C100&amp;w=96 2x" src="https://platform.theverge.com/wp-content/uploads/sites/2/2025/01/RICHARD_BLURPLE.jpg?quality=90&amp;strip=all&amp;crop=0%2C0%2C100%2C100&amp;w=96"></p><p><span>Richard Lawler</span><span><time datetime="2026-11-06T22:03:37+00:00">Nov 6</time></span></p></div><div><p>TSMC is apparently considering getting into the RAM business at the request of Nvidia.</p><p>A report by <em>The Information</em> claims that the world’s biggest chipmaker is considering adding memory back into its portfolio, starting with <a href="https://www.theverge.com/2011/12/7/2616348/3d-dram-ibm-micron-128-gbps">next-generation 3D DRAM</a>.</p><p>With demand still outpacing supply and prices sky-high, the outlet says it could compete with memory giants Micron, Samsung, and SK Hynix to develop and produce 3D DRAM technology that stacks chips vertically for increased bandwidth, capacity, and power efficiency.</p></div></div><div id="latest-dmcyOnBvc3Q6MTAyODY0MA=="><p><img alt="KPop Demon Hunters on 4K Blu-ray costs less than a month of Netflix Premium" data-chromatic="ignore" loading="lazy" decoding="async" data-nimg="fill" sizes="100px" srcset="https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=32 32w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=48 48w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=64 64w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=96 96w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=128 128w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SDR_2ch_20250424.01_04_39_22.jpg?quality=90&amp;strip=all&amp;crop=29.0625%2C0%2C41.875%2C100&amp;w=256 256w, https://platform.theverge.com/wp-content/uploads/sites/2/2025/08/KpopDemonHunters_ProRes422HQ_SD