# Local overrides used for the UI-capture build (copied to /.env.production.local)
# No external services: everything points at localhost placeholders.
VITE_APP_BACKEND_V2_GET_URL=/stub-api/v2/
VITE_APP_BACKEND_V2_POST_URL=/stub-api/v2/post/
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=/stub-api/libraries
VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com
VITE_APP_AI_BACKEND=/stub-ai
VITE_APP_WS_SERVER_URL=http://localhost:4471
VITE_APP_FIREBASE_CONFIG='{"apiKey":"placeholder-local-key","authDomain":"localhost","projectId":"local-placeholder","storageBucket":"local-placeholder.appspot.com","messagingSenderId":"000000000000","appId":"1:000000000000:web:0000000000000000"}'
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
VITE_APP_ENABLE_PWA=false
VITE_APP_DISABLE_PREVENT_UNLOAD=true
