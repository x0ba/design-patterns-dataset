{
  "name": "design-patterns-dataset",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "codebook:extract": "node scripts/extract-atlas.ts",
    "codebook:build": "node scripts/build-codebook.ts",
    "codebook:validate": "node scripts/validate-codebook.ts",
    "codebook:roundtrip": "node scripts/verify-roundtrip.ts",
    "label": "node scripts/label.ts",
    "capture": "node scripts/capture.ts",
    "irr": "node scripts/irr.ts",
    "variety": "node scripts/site-variety.ts",
    "proposals": "node scripts/proposals.ts",
    "console": "node console/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/label.ts --batch dry-run --sites sites/dry-run.yaml --raters config/raters.dry-run.yaml && node scripts/irr.ts --batch dry-run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.65.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.0"
}
