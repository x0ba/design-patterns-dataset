{
  "name": "pairwise-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild tests/swiss.test.ts --bundle --platform=node --format=esm --outfile=.tmp/swiss.test.mjs --log-level=warning && node --test .tmp/swiss.test.mjs",
    "gen:mock": "esbuild scripts/gen-mock.ts --bundle --platform=node --format=esm --outfile=.tmp/gen-mock.mjs --log-level=warning && node .tmp/gen-mock.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "0.21.5"
  }
}
