{
  "name": "tapcard-assist-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Review front end for Tapcard Assist, the lead service line material classification assistant.",
  "scripts": {
    "generate:batch": "node scripts/generate-batch.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --outDir out"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
