node_modules/
.env
*.log

# scripts/build-codebook.ts output. CI rebuilds it; codebook/ is the source.
dist/

# dataset/ and generated/ are versioned (binaries via Git LFS, see
# .gitattributes). Throwaway batches are not: `pnpm smoke` uses dry-run, and
# experiments should be named scratch-* so nothing they write gets committed.
dataset/dry-run/
generated/dry-run/
proposals/dry-run/
dataset/scratch-*/
generated/scratch-*/
proposals/scratch-*/
sites/scratch-*.yaml
briefs/scratch-*.yaml
repos/scratch-*/
repos/scratch-*.yaml

# Rewritten by the rater's box-overlay tool on every call.
dataset/**/capture/_viewer.html

.DS_Store

# Next.js console build output.
console/.next/
console/next-env.d.ts
*.tsbuildinfo

# Seeded app workspaces that carry their own .git (git would commit them as a
# broken submodule). The app's ui-capture/seed/seed.sh rebuilds them.
repos/repo-001/open-knowledge/ui-capture/workspace/
