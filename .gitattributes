# Run output is versioned. Binary and bulky files under dataset/ and generated/
# go through Git LFS; the small JSON people actually review (labels, consensus,
# agreement, irr, batch, status, generation, captured element/style indexes)
# stays plain git so it diffs. See README "Versioning data".

# Built app bundles: minified, regenerated wholesale, never diffed by hand.
generated/**/out/** filter=lfs diff=lfs merge=lfs -text

# Agent transcripts: large, append-only logs.
dataset/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
generated/**/*.jsonl filter=lfs diff=lfs merge=lfs -text

# Images, fonts, media anywhere in run output.
dataset/**/*.png filter=lfs diff=lfs merge=lfs -text
dataset/**/*.jpg filter=lfs diff=lfs merge=lfs -text
dataset/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
dataset/**/*.webp filter=lfs diff=lfs merge=lfs -text
generated/**/*.png filter=lfs diff=lfs merge=lfs -text
generated/**/*.jpg filter=lfs diff=lfs merge=lfs -text
generated/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
generated/**/*.gif filter=lfs diff=lfs merge=lfs -text
generated/**/*.webp filter=lfs diff=lfs merge=lfs -text
generated/**/*.avif filter=lfs diff=lfs merge=lfs -text
